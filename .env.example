# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# The make targets load it automatically (uv run --env-file) when the file
# exists. Nothing loads it in CI: GitHub Actions never checks out a .env, so
# every value below that CI needs is a repository secret instead.
#
# This repository is the PAYER. It is the only side that holds a credential
# capable of moving money -- the firm gets a read-only rk_ and can do nothing
# but observe that payment arrived. A supplier who can charge you at will is
# not a counterparty, it is a subscription.


# ─── Placing orders ────────────────────────────────────────────────────────────
# Fine-grained token scoped to Issues:write on the FIRM repository and nothing
# else. That scope IS the trust boundary: with it this agent can place an order
# and cannot push code, merge a pull request, or edit a workflow. Widening it
# would quietly delete the boundary the whole project claims to have.
CLIENT_GITHUB_TOKEN=
FIRM_REPO=dntywntme/2026-08-15-SF-0HumanCompanyHack-firm

# Where our human is. Stated on every order rather than left for the supplier to
# assume: Broker applies its strictest notice set to an order that does not say,
# which is safe but tells our human less about the answer they are reading.
# One of: eu | uk | us | us-ca | unspecified.
CLIENT_JURISDICTION=us-ca

# Where the firm publishes its run. Read without any credential -- it is a
# public static site, which is the honest channel for a counterparty: nothing to
# revoke, and anyone else can fetch exactly what we fetch and check we read it
# correctly. Must be https; the client refuses any other scheme.
FIRM_SITE=https://dntywntme.github.io/2026-08-15-SF-0HumanCompanyHack-firm


# ─── Paying ────────────────────────────────────────────────────────────────────
# sk_test_ ONLY. pay.py refuses any other key shape, because an agent settling
# invoices with no human in the loop must not be able to reach live money.
# Amounts under Stripe's $0.50 floor are refused before the call is made.
CLIENT_STRIPE_KEY=
